DJANGO_SECRET_KEY=replace-with-a-long-random-string
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000
DJANGO_SECURE_SSL_REDIRECT=0
CANONICAL_PUBLIC_ORIGIN=
STUDENT_SESSION_IDLE_TIMEOUT_SECONDS=1800
TIME_ZONE=Asia/Shanghai
POSTGRES_DB=kt_platform
POSTGRES_USER=kt_user
POSTGRES_PASSWORD=replace-me
POSTGRES_HOST=
POSTGRES_PORT=5432

SEED_DEMO=1
# auto reads the CPU quota and memory limit visible inside the server container.
GUNICORN_WORKERS=auto
GUNICORN_MEMORY_PER_WORKER_MB=512
GUNICORN_MAX_REQUESTS=2000
GUNICORN_MAX_REQUESTS_JITTER=200
WEB_REPLICAS=2
# Multi-host deployments may set these to measured totals. Blank values use the
# CPU quota and memory limit visible inside the deployed server container.
DEPLOYMENT_AGGREGATE_VCPU=
DEPLOYMENT_AGGREGATE_MEMORY_MB=
PUBLICATION_WORKER_CPUS=2
PUBLICATION_WORKER_MEMORY=2G
DATABASE_CONN_MAX_AGE=60
PGBOUNCER_DEFAULT_POOL_SIZE=40
PGBOUNCER_RESERVE_POOL_SIZE=10
HTTP_PORT=80

CLASS_CENTER_ENABLED=0
STUDENT_LEARNING_ANALYTICS_ENABLED=0
# Background per-session research projections; enable only for explicit course IDs (or *).
ADVANCED_DATA_MATERIALIZED_ENABLED=0
ADVANCED_DATA_MATERIALIZED_COURSE_IDS=
VUE_TEACHER_EXPERIMENTS_ENABLED=0
VUE_TEACHER_COURSES_ENABLED=0
VUE_TEACHER_COURSES_COURSE_IDS=
VUE_TEACHER_COURSES_USER_IDS=
VUE_TEACHER_QUESTION_BANKS_ENABLED=0
VUE_TEACHER_CLASSES_ENABLED=0
VUE_TEACHER_DATA_CENTER_ENABLED=0
VUE_STUDENT_COURSES_ENABLED=0
VUE_STUDENT_ASSESSMENT_ENABLED=0

# Independent frontend is the default for new installations; use allowlists for staged rollout.
VUE_STANDALONE_ENABLED=1
VUE_STANDALONE_COURSE_IDS=
VUE_STANDALONE_USER_IDS=
# Nginx serves the separately built HTML at this internal location.
FRONTEND_INTERNAL_REDIRECT=

# New sessions only; requires the Vue assessment runtime and an explicit course/user allowlist.
# Use CAPTURE_V2_ENABLED=1 and CAPTURE_V2_COURSE_IDS=* for all current and future courses.
# Existing sessions retain their pinned contract. Keep their v2 runtime available during rollback.
CAPTURE_V2_ENABLED=0
CAPTURE_V2_COURSE_IDS=
CAPTURE_V2_USER_IDS=
