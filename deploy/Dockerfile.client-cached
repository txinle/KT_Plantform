# Build from the independently generated, hash-bound client artifact when the
# school host cannot fetch Node/npm. The base is an explicitly verified Nginx image.
ARG SCHOOL_CACHED_NGINX_BASE
FROM ${SCHOOL_CACHED_NGINX_BASE} AS production
RUN rm -rf /static /opt/kt-frontend-assets /opt/kt-frontend-shells
COPY client/nginx.conf /etc/nginx/conf.d/default.conf
COPY .school-client/spa-assets/ /static/spa-assets/
COPY .school-client/spa-assets/assets/ /opt/kt-frontend-assets/
COPY .school-client/spa-assets/capture-shell-*.html /opt/kt-frontend-shells/
COPY client/legacy/js/ /static/js/
COPY deploy/docker/20-frontend-assets.sh /docker-entrypoint.d/20-frontend-assets.sh
RUN sed -i 's/\r$//' /docker-entrypoint.d/20-frontend-assets.sh && chmod +x /docker-entrypoint.d/20-frontend-assets.sh
