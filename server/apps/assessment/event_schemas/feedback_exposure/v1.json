{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "capture_version",
    "operation_id",
    "feedback_mode",
    "stage",
    "answer_event_id",
    "snapshot_id",
    "included_correctness",
    "included_correct_answer",
    "included_explanation"
  ],
  "properties": {
    "capture_version": {"const": "capture-v2"},
    "operation_id": {"type": "string", "format": "uuid"},
    "feedback_mode": {"enum": ["correctness", "full"]},
    "stage": {
      "enum": [
        "detail_entered",
        "answer_presented",
        "explanation_presented",
        "detail_left"
      ]
    },
    "answer_event_id": {
      "type": ["string", "null"],
      "format": "uuid"
    },
    "snapshot_id": {
      "type": ["string", "null"],
      "format": "uuid"
    },
    "included_correctness": {"type": "boolean"},
    "included_correct_answer": {"type": "boolean"},
    "included_explanation": {"type": "boolean"}
  }
}
