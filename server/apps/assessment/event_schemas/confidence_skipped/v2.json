{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "confidence_assignment_id": {
      "type": "string",
      "format": "uuid"
    },
    "reason_code": {
      "type": "string",
      "enum": [
        "student_skipped",
        "navigation",
        "session_closed",
        "deadline_expired",
        "upload_failed"
      ]
    }
  },
  "required": [
    "confidence_assignment_id",
    "reason_code"
  ],
  "additionalProperties": false
}
