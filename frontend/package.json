{
  "name": "kt-data-lab-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "lint": "eslint .",
    "typecheck": "vue-tsc --noEmit",
    "test:unit": "vitest run",
    "test:e2e": "node --test scripts/e2e-database.test.mjs && node scripts/prepare-e2e.mjs && playwright test",
    "api:schema": "node scripts/generate-api-schema.mjs",
    "api:generate": "npm run api:schema && openapi-typescript ../openapi-schema.yml -o src/api/generated/schema.d.ts",
    "api:check": "node scripts/check-api-types.mjs",
    "test:e2e:capture": "npm run build && node scripts/prepare-e2e.mjs --capture-v2 && playwright test --config playwright.capture-v2.config.ts"
  },
  "dependencies": {
    "pinia": "3.0.4",
    "vue": "3.5.42",
    "vue-router": "4.6.3"
  },
  "devDependencies": {
    "@eslint/js": "9.39.1",
    "@playwright/test": "1.62.1",
    "@types/node": "24.13.3",
    "@vitejs/plugin-vue": "6.0.8",
    "@vitest/coverage-v8": "4.1.11",
    "@vue/eslint-config-typescript": "14.9.0",
    "@vue/test-utils": "2.4.6",
    "eslint": "9.39.1",
    "eslint-plugin-vue": "10.10.0",
    "jsdom": "30.0.1",
    "openapi-typescript": "7.13.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.68.0",
    "vite": "8.2.2",
    "vitest": "4.1.11",
    "vue-tsc": "3.3.11"
  }
}
