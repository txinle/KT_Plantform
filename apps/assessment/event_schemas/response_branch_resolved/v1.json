{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "capture_version",
    "operation_id",
    "candidate_event_ids",
    "selected_event_id",
    "expected_version"
  ],
  "properties": {
    "capture_version": {
      "const": "capture-v2"
    },
    "operation_id": {
      "type": "string",
      "format": "uuid"
    },
    "candidate_event_ids": {
      "type": "array",
      "minItems": 2,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "format": "uuid"
      }
    },
    "selected_event_id": {
      "type": "string",
      "format": "uuid"
    },
    "expected_version": {
      "type": "integer",
      "minimum": 0
    }
  }
}
