{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "submission_token": {
      "type": "string",
      "format": "uuid"
    },
    "score": {
      "type": "number"
    },
    "is_correct": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "grading_status": {
      "type": "string",
      "enum": ["pending", "completed", "regrade"]
    }
  },
  "required": [
    "submission_token"
  ],
  "additionalProperties": false
}
