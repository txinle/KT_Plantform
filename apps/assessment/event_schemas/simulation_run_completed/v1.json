{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "simulation_snapshot_id": {
      "type": "string",
      "format": "uuid"
    },
    "run_id": {
      "type": "string",
      "format": "uuid"
    },
    "status": {
      "type": "string",
      "enum": [
        "success",
        "failure"
      ]
    }
  },
  "required": [
    "simulation_snapshot_id",
    "run_id",
    "status"
  ],
  "additionalProperties": false
}
